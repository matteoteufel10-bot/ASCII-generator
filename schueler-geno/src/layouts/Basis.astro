---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { SEITE } from '../einstellungen';
import { link } from '../hilfen';

interface Props {
  titel?: string;
  beschreibung?: string;
  schmal?: boolean;
}
const { titel, beschreibung = SEITE.beschreibung, schmal = false } = Astro.props;
const seitenTitel = titel ? `${titel} | ${SEITE.name}` : `${SEITE.name} | ${SEITE.schule}`;

const pfad = Astro.url.pathname;
const start = link('/');
const navigation = [
  { text: 'Aktuelles', ziel: start, aktiv: pfad === start || pfad.startsWith(link('/beitraege/')) },
  { text: 'Über uns', ziel: link('/ueber-uns/'), aktiv: pfad.startsWith(link('/ueber-uns/')) },
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitenTitel}</title>
    <meta name="description" content={beschreibung} />
    <meta property="og:title" content={titel ?? SEITE.name} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta name="theme-color" content="#091530" />
    <link rel="icon" type="image/svg+xml" href={link('/favicon.svg')} />
  </head>
  <body>
    <a class="sprunglink" href="#inhalt">Zum Inhalt springen</a>
    <header class="kopf">
      <div class="breite kopf-innen">
        <a class="marke" href={start}>
          <img src={link('/logo.svg')} alt="" width="36" height="36" />
          <span>
            <span class="marke-name">{SEITE.name}</span>
            <span class="marke-schule">{SEITE.schule}</span>
          </span>
        </a>
        <nav class="navigation" aria-label="Hauptnavigation">
          <ul>
            {navigation.map((punkt) => (
              <li><a href={punkt.ziel} aria-current={punkt.aktiv ? 'page' : undefined}>{punkt.text}</a></li>
            ))}
            <li class="nav-knopf"><a href={link('/ueber-uns/#mitmachen')}>Mitmachen</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="inhalt">
      <slot name="buehne" />
      <div class:list={['breite', 'inhalt', { schmal }]}>
        <slot />
      </div>
    </main>

    <footer class="fuss">
      <div class="breite">
        <div class="fuss-raster">
          <div class="fuss-marke">
            <a class="marke" href={start}>
              <img src={link('/logo.svg')} alt="" width="36" height="36" loading="lazy" />
              <span class="marke-name">{SEITE.name}</span>
            </a>
            <p>Die Schülergenossenschaft am {SEITE.schule}.</p>
          </div>
          <nav aria-label="Seiten">
            <p class="fuss-titel">Seiten</p>
            <ul>
              <li><a href={start}>Aktuelles</a></li>
              <li><a href={link('/ueber-uns/')}>Über uns</a></li>
              <li><a href={link('/ueber-uns/#mitmachen')}>Mitmachen</a></li>
            </ul>
          </nav>
          <nav aria-label="Rechtliches">
            <p class="fuss-titel">Rechtliches</p>
            <ul>
              <li><a href={link('/impressum/')}>Impressum</a></li>
              <li><a href={link('/datenschutz/')}>Datenschutz</a></li>
            </ul>
          </nav>
        </div>
        <p class="fuss-hinweis">
          <Icon name="schild" groesse={18} />
          <span>Diese Website kommt ohne Cookies, Tracking und externe Schriften aus.</span>
        </p>
      </div>
    </footer>
  </body>
</html>
