---
// Auffälliger Warnhinweis für Seiten, die noch ausgefüllt werden müssen.
import Icon from './Icon.astro';
---
<div class="hinweis-platzhalter" role="note">
  <span class="hinweis-symbol" aria-hidden="true"><Icon name="warnung" groesse={26} /></span>
  <div>
    <strong>Noch auszufüllen</strong>
    <p><slot /></p>
  </div>
</div>
