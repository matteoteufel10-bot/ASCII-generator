---
import { getCollection } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import BeitragsKarte from '../components/BeitragsKarte.astro';
import Ankuendigung from '../components/Ankuendigung.astro';
import Icon from '../components/Icon.astro';
import { SEITE } from '../einstellungen';
import { link } from '../hilfen';

const alle = (await getCollection('beitraege')).sort(
  (a, b) => b.data.datum.valueOf() - a.data.datum.valueOf(),
);
const ankuendigungen = alle.filter((b) => b.data.kategorie === 'Ankündigung');
const neuigkeiten = alle.filter((b) => b.data.kategorie === 'Neuigkeit');
---
<Basis>
  <section slot="buehne" class="buehne buehne-start">
    <div class="breite buehne-innen start-raster">
      <div class="start-text">
        <p class="dachzeile">Schülergenossenschaft am PHG Nürtingen</p>
        <h1>Gemeinsam wirtschaften. <em>Gemeinsam entscheiden.</em></h1>
        <p class="vorspann">
          Die {SEITE.name} ist die Schülergenossenschaft am {SEITE.schule}. Hier erfahrt ihr, was
          gerade läuft und was als Nächstes ansteht.
        </p>
        <div class="knopfreihe">
          <a class="knopf knopf-akzent" href="#aktuelles">Aktuelles lesen <Icon name="pfeil-rechts" groesse={18} /></a>
          <a class="knopf knopf-glas" href={link('/ueber-uns/#mitmachen')}>Mitmachen</a>
        </div>
      </div>
      <ul class="werte">
        <li>
          <span class="symbol-kachel"><Icon name="stimme" /></span>
          <span><strong>Ein Mitglied, eine Stimme</strong> Alle entscheiden gleichberechtigt mit.</span>
        </li>
        <li>
          <span class="symbol-kachel"><Icon name="tasche" /></span>
          <span><strong>Eigene Projekte</strong> Von der Idee bis zum Verkauf selbst gemacht.</span>
        </li>
        <li>
          <span class="symbol-kachel"><Icon name="idee" /></span>
          <span><strong>Echte Verantwortung</strong> Einkauf, Finanzen und Werbung selbst organisiert.</span>
        </li>
      </ul>
    </div>
  </section>

  <div class="filterleiste" id="aktuelles">
    <h2>Aktuelles</h2>
    {alle.length > 0 && (
      <div class="filter" id="filter" role="group" aria-label="Beiträge nach Kategorie filtern" hidden>
        <button type="button" data-filter="alle" aria-pressed="true">Alle <span class="anzahl">{alle.length}</span></button>
        <button type="button" data-filter="Ankündigung" aria-pressed="false">Ankündigungen <span class="anzahl">{ankuendigungen.length}</span></button>
        <button type="button" data-filter="Neuigkeit" aria-pressed="false">Neuigkeiten <span class="anzahl">{neuigkeiten.length}</span></button>
      </div>
    )}
  </div>
  <p class="nur-vorleser" id="filter-status" aria-live="polite"></p>

  {alle.length === 0 && <p class="leer">Noch keine Beiträge vorhanden. Schaut bald wieder vorbei!</p>}

  <section class="abschnitt" data-abschnitt="Ankündigung" aria-labelledby="titel-ankuendigungen">
    <h3 class="abschnitt-titel" id="titel-ankuendigungen"><Icon name="megafon" groesse={18} /> Ankündigungen</h3>
    {ankuendigungen.length > 0 ? (
      <ul class="ansagen">
        {ankuendigungen.map((beitrag) => <Ankuendigung beitrag={beitrag} />)}
      </ul>
    ) : (
      <p class="leer">Gerade gibt es keine Ankündigungen.</p>
    )}
  </section>

  <section class="abschnitt" data-abschnitt="Neuigkeit" aria-labelledby="titel-neuigkeiten">
    <h3 class="abschnitt-titel" id="titel-neuigkeiten"><Icon name="zeitung" groesse={18} /> Neuigkeiten</h3>
    {neuigkeiten.length > 0 ? (
      <ul class="karten">
        {neuigkeiten.map((beitrag, nummer) => <BeitragsKarte beitrag={beitrag} gross={nummer === 0} ebene={4} />)}
      </ul>
    ) : (
      <p class="leer">Noch keine Neuigkeiten vorhanden.</p>
    )}
  </section>

  <section class="aufruf" aria-labelledby="titel-aufruf">
    <div>
      <h2 id="titel-aufruf">Lust, mitzumachen?</h2>
      <p>Ob Verkauf, Finanzen oder Öffentlichkeitsarbeit: Bei uns findest du eine Aufgabe, die zu dir passt.</p>
    </div>
    <a class="knopf knopf-akzent" href={link('/ueber-uns/#mitmachen')}>So geht’s <Icon name="pfeil-rechts" groesse={18} /></a>
  </section>
</Basis>

<script>
  // Kategorie-Filter. Ohne JavaScript bleiben einfach alle Beiträge sichtbar.
  const filter = document.getElementById('filter');
  const status = document.getElementById('filter-status');
  if (filter) {
    filter.hidden = false;
    const knoepfe = filter.querySelectorAll<HTMLButtonElement>('button');
    const abschnitte = document.querySelectorAll<HTMLElement>('[data-abschnitt]');
    filter.addEventListener('click', (ereignis) => {
      const knopf = (ereignis.target as HTMLElement).closest('button');
      if (!knopf) return;
      const auswahl = knopf.dataset.filter;
      knoepfe.forEach((k) => k.setAttribute('aria-pressed', String(k === knopf)));
      let anzahl = 0;
      abschnitte.forEach((abschnitt) => {
        const sichtbar = auswahl === 'alle' || abschnitt.dataset.abschnitt === auswahl;
        abschnitt.hidden = !sichtbar;
        if (sichtbar) anzahl += abschnitt.querySelectorAll('li[data-kategorie]').length;
      });
      if (status) status.textContent = `${anzahl} ${anzahl === 1 ? 'Beitrag' : 'Beiträge'} angezeigt`;
    });
  }
</script>
