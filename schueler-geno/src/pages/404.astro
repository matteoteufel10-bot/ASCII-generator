---
import Basis from '../layouts/Basis.astro';
import { link } from '../hilfen';
---
<Basis titel="Seite nicht gefunden" schmal>
  <div class="text">
    <h1>Seite nicht gefunden</h1>
    <p>Diese Seite gibt es leider nicht (mehr). Vielleicht wurde der Beitrag umbenannt oder gelöscht.</p>
    <p><a class="knopf" href={link('/')}>Zur Startseite</a></p>
  </div>
</Basis>
