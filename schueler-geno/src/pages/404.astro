---
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import Icon from '../components/Icon.astro';
import { link } from '../hilfen';
---
<Basis titel="Seite nicht gefunden" schmal>
  <Seitenkopf
    slot="buehne"
    dachzeile="Fehler 404"
    titel="Diese Seite gibt es nicht"
    vorspann="Vielleicht wurde der Beitrag umbenannt oder gelöscht."
  />
  <p><a class="knopf" href={link('/')}><Icon name="pfeil-links" groesse={18} /> Zur Startseite</a></p>
</Basis>
