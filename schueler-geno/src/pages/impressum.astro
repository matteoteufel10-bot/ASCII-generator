---
import Basis from '../layouts/Basis.astro';
import Platzhalter from '../components/Platzhalter.astro';
---
<Basis titel="Impressum" schmal>
  <div class="text">
    <h1>Impressum</h1>
    <Platzhalter>
      Diese Seite ist ein Platzhalter und noch kein gültiges Impressum. Bitte vor der
      Veröffentlichung gemeinsam mit der Schulleitung bzw. dem Schulträger ausfüllen.
    </Platzhalter>

    <h2>Verantwortlich für diese Website</h2>
    <p>
      <mark class="offen">[Name des Anbieters, z. B. Schule oder Schulträger]</mark><br />
      <mark class="offen">[Straße und Hausnummer]</mark><br />
      <mark class="offen">[PLZ und Ort]</mark>
    </p>

    <h2>Vertreten durch</h2>
    <p><mark class="offen">[Vertretungsberechtigte Person, z. B. Schulleitung]</mark></p>

    <h2>Kontakt</h2>
    <p>
      Telefon: <mark class="offen">[Telefonnummer]</mark><br />
      E-Mail: <mark class="offen">[E-Mail-Adresse]</mark>
    </p>

    <h2>Inhaltlich verantwortlich</h2>
    <p><mark class="offen">[Name und Anschrift der inhaltlich verantwortlichen Person]</mark></p>
  </div>
</Basis>
